/-- Exact nonzero-output probability of the sparse row distribution. -/
def rowProbability (w : ℝ) : ℝ :=
  (1 - 1 / 2^128) * (1 - (1 - w / 68853957121)^52500)

theorem mul_interval {x y l u a b L U : ℝ}
    (hx : l ≤ x ∧ x ≤ u) (hy : a ≤ y ∧ y ≤ b)
    (hl : 0 ≤ l) (ha : 0 ≤ a)
    (hL : L ≤ l*a) (hU : u*b ≤ U) : L ≤ x*y ∧ x*y ≤ U := by
  have hx0 : 0 ≤ x := hl.trans hx.1
  have hb0 : 0 ≤ b := ha.trans (hy.1.trans hy.2)
  exact ⟨hL.trans (mul_le_mul hx.1 hy.1 ha hx0),
    (mul_le_mul hx.2 hy.2 (ha.trans hy.1) (hl.trans hx.1 |>.trans hx.2)).trans hU⟩

theorem square_interval {x l u L U : ℝ}
    (hx : l ≤ x ∧ x ≤ u) (hl : 0 ≤ l)
    (hL : L ≤ l*l) (hU : u*u ≤ U) : L ≤ x^2 ∧ x^2 ≤ U := by
  simpa only [pow_two] using mul_interval hx hx hl hl hL hU

